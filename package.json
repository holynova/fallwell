{
  "name": "fallwell",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test src/*.test.ts",
    "deploy": "npm run build && npx --yes wrangler@4.145.0 deploy --config wrangler.jsonc",
    "preview": "vite preview --host 127.0.0.1",
    "deploy:check": "npx --yes wrangler@4.145.0 deploy --dry-run --config wrangler.jsonc"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "vite": "^7.1.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "@types/node": "^24.0.0"
  }
}
