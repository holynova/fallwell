{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fallwell",
  "account_id": "ef7863c4de93e71c3496f940c8ab4865",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "xiaosang.cc/fallwell",
      "zone_name": "xiaosang.cc"
    },
    {
      "pattern": "xiaosang.cc/fallwell/*",
      "zone_name": "xiaosang.cc"
    }
  ],
  "main": "worker/index.ts"
}
